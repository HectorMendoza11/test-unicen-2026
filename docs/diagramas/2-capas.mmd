    IN["<b>4. Infraestructura</b> — Repositorios TypeORM · Listener de auditoría<br/><i>Implementa las interfaces del dominio con tecnología concreta</i>"]
    BD[("PostgreSQL")]

    P -- llama a --> AP
    AP -- usa --> DO
    IN -- implementa --> DO
    IN -- guarda en --> BD

