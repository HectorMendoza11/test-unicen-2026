# Copiar este archivo como .env (docker compose lo lee automáticamente).
# Todos los valores tienen un default en docker-compose.yml, así que .env es opcional.

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=unicen
POSTGRES_PASSWORD=unicen
POSTGRES_DB=sistema_academico
# Host de la BD: "db" dentro de Docker; usar "localhost" si la API corre fuera de Docker.
DB_HOST=db
DB_PORT=5432

# --- API (NestJS) ---
API_PORT=3000
# Clave para firmar los JWT. Cambiarla en cualquier entorno real.
JWT_SECRET=cambiar_este_secreto
# Duración del token en segundos (3600 = 1 hora).
JWT_EXPIRES_IN=3600

# --- Web (React servida por nginx) ---
WEB_PORT=8080
